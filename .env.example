# ---------------------------------------------------------------------------
# Smart Grid Lambda Pipeline - environment template
# Copy to .env before running:  cp .env.example .env
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=smartgrid

# --- Simulated clock --------------------------------------------------------
# One simulated day is compressed into SIM_DAY_SECONDS of wall-clock time.
# 300s = 5 min per simulated day (assignment-suggested compression).
SIM_DAY_SECONDS=300
# Wall-clock seconds between two meter readings from the same meter.
STREAM_INTERVAL_SECONDS=2
# Simulated date the run starts from.
SIM_START_DATE=2026-01-01

# --- Simulation scale -------------------------------------------------------
NUM_HOUSEHOLDS=60
NUM_ZONES=4

# --- Fault injection (drives the data-quality + alerting demo) --------------
ANOMALY_RATE=0.03          # spikes / implausible values
DUPLICATE_RATE=0.02        # exactly-duplicated events (dedup demo)
LATE_EVENT_RATE=0.02       # out-of-order events (watermark demo)
NULL_FIELD_RATE=0.02       # sensor dropout (null solar / voltage)

# --- Kafka ------------------------------------------------------------------
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC_READINGS=meter.readings
KAFKA_TOPIC_DLQ=meter.readings.dlq
KAFKA_TOPIC_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1

# --- PostgreSQL (serving layer + Airflow metadata) --------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=grid
POSTGRES_PASSWORD=gridpass
POSTGRES_DB=smartgrid
POSTGRES_AIRFLOW_DB=airflow

# --- MinIO (S3-compatible master dataset + batch landing zone) --------------
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=smartgrid

# --- Spark ------------------------------------------------------------------
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G
# Streaming micro-batch trigger (WALL-CLOCK seconds).
STREAM_TRIGGER_SECONDS=10
# Tumbling window for real-time zone aggregates, in SIMULATED seconds.
# 3600 sim-seconds = 1 simulated hour = ~12.5 wall seconds at 288x compression,
# giving 24 windows per simulated day at a readable dashboard cadence.
STREAM_WINDOW_SECONDS=3600
# Watermark in SIMULATED seconds. Must exceed the producer late-event backdating
# (max 900 sim-seconds) so late readings are still folded into their own window.
STREAM_WATERMARK_SECONDS=1800

# --- Business thresholds (alerting) -----------------------------------------
RENEWABLE_LOW_PCT=15.0         # zone renewable contribution alert floor
ZONE_OVERLOAD_KWH=45.0         # zone load alert ceiling per window
METER_SILENCE_SECONDS=90       # meter considered silent after this gap
CONSUMPTION_SPIKE_FACTOR=3.0   # x baseline -> spike alert

# --- Serving API ------------------------------------------------------------
API_PORT=8000
LOG_LEVEL=INFO
